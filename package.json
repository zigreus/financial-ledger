{
  "name": "financial-ledger",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@azure/msal-browser": "^3.28.1",
    "@azure/msal-react": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "1.12.0"
  },
  "scripts": {
    "prestart": "node scripts/copy-sql-wasm.js",
    "start": "vite",
    "prebuild": "node scripts/copy-sql-wasm.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts --max-warnings=0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "overrides": [
      {
        "files": [
          "**/__tests__/**/*.js",
          "**/*.test.js"
        ],
        "globals": {
          "describe": "readonly",
          "test": "readonly",
          "it": "readonly",
          "expect": "readonly",
          "vi": "readonly",
          "beforeAll": "readonly",
          "beforeEach": "readonly",
          "afterAll": "readonly",
          "afterEach": "readonly"
        }
      }
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "jsdom": "^25.0.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
